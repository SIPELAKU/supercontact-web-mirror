NODE_TLS_REJECT_UNAUTHORIZED=
NEXT_PUBLIC_WS_URL=
BACKEND_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ENABLE_LOGGER=
# Unreleased Data Intelligence features (Prospecting, "Unlimited (dev)" credit
# pill, Website Intelligence card). Shown ONLY when set to exactly "true";
# unset/empty keeps them hidden. Leave unset in Production. See
# lib/config/featureFlags.ts.
NEXT_PUBLIC_ENABLE_DATA_INTEL_PREVIEW=
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Analytics/CTA
# tracking is fully inert (no script loaded) until this is set.
# NOTE: even when set, scripts only load on smartsales.id/www.smartsales.id
# (see analyticsAllowedOnHost in lib/analytics/gtag.ts) so dev/staging/preview
# hosts can never pollute production data.
NEXT_PUBLIC_GA_ID=
# Google Ads tag (e.g. AW-XXXXXXXXXX) + the conversion label of the
# "Registration completed" conversion action. Both inert until set.
# Production-only; never set these outside the Production Vercel env.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_REGISTER_LABEL=
# Local-debug override for the host guard above. NEVER set in a deployed env.
NEXT_PUBLIC_ANALYTICS_DEBUG=